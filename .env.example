# Your PrijsProfeet partner key, sent as the X-API-Key header.
# Get one at https://www.prijsprofeet.nl/api
# Leave empty to run on the anonymous (Gratis) tier, which needs no key at all.
PRIJSPROFEET_API_KEY=

# Bearer token for the HTTP transport. Generate one with:
#   openssl rand -base64 32
# Leave unset only for loopback/local use: without it /mcp accepts any caller,
# and every one of them spends this key's rate limit.
# Comma-separated to rotate without downtime: new,old
MCP_AUTH_TOKEN=

# Which PrijsProfeet plan the key is on. `free` withholds the 6 Pro-gated
# tools (all of /api/v1/match/*, shelf-prices, price-history) so the model never
# sees a tool that would just 403. Set to `pro` to get all 25 back.
PRIJSPROFEET_PLAN=free

# Override to point at a different host (staging, a proxy, a mock).
PRIJSPROFEET_BASE_URL=https://www.prijsprofeet.nl

# stdio (default) = the MCP client launches the container and talks over
# stdin/stdout, no port. http = serve Streamable HTTP for clients that want a
# URL; see PRIJSPROFEET_HTTP_* below.
PRIJSPROFEET_TRANSPORT=stdio

# Only used when PRIJSPROFEET_TRANSPORT=http. The MCP endpoint is
# http://<host>:<port><path>, plus /healthz for probes.
PRIJSPROFEET_HTTP_HOST=0.0.0.0
PRIJSPROFEET_HTTP_PORT=3000
PRIJSPROFEET_HTTP_PATH=/mcp

# Address the compose "http" profile publishes on. Keep it on loopback: the API
# key is server-side, so anything that can reach the URL spends your rate limit.
PRIJSPROFEET_HTTP_BIND=127.0.0.1

# Per-request timeout in milliseconds.
PRIJSPROFEET_TIMEOUT_MS=30000

# Retries for 429/5xx and network errors.
PRIJSPROFEET_MAX_RETRIES=2

# Responses above this many bytes are truncated instead of returned whole.
PRIJSPROFEET_MAX_RESPONSE_BYTES=250000

# Fetch the OpenAPI document from PRIJSPROFEET_SPEC_URL at startup
# instead of using the copy bundled in the image.
PRIJSPROFEET_REFRESH_SPEC=0
PRIJSPROFEET_SPEC_URL=https://www.prijsprofeet.nl/openapi.json

# Diagnostics on stderr.
DEBUG=0
